{
  "manifest_version": 3,
  "name": "PHP Precaution — Swarmkind",
  "version": "0.2.1",
  "description": "Strict browsing: blocks unapproved hosts and shows known PHP indicators. Approval is not a security check.",
  "minimum_chrome_version": "128",
  "permissions": ["declarativeNetRequest", "storage", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Manage PHP Precaution"},
  "options_page": "settings.html",
  "declarative_net_request": {"rule_resources": [{"id": "strict", "enabled": true, "path": "strict.json"}]},
  "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["http://*/*", "https://*/*"]}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
}
